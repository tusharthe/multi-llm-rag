# ── Local development bypass ────────────────────────────────────────────────
# true  = use local Ollama models (free, offline; needs Ollama running)
# false = use the real OpenAI / Anthropic / Gemini APIs (needs funded keys)
USE_OLLAMA=true

# Which local model backs each provider slot in dev mode (any pulled Ollama tag).
OLLAMA_OPENAI_MODEL=llama3.2:3b
OLLAMA_ANTHROPIC_MODEL=qwen2.5:3b
OLLAMA_GEMINI_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Override only if Ollama is not on the default host:
# OLLAMA_BASE_URL=http://localhost:11434

# ── Cloud API keys (only needed when USE_OLLAMA=false) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
